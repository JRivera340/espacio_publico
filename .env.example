NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:5175
FRONTEND_URL=http://localhost:5175

# Secreto para verificar los JWT emitidos por el hub. En produccion tiene que
# ser EXACTAMENTE el mismo valor que usa el hub, o el handoff no valida.
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Backend del hub, usado por el proxy de usuarios.
HUB_API_URL=http://localhost:3000

DB_HOST=localhost
# docker-compose.yml mapea el Postgres del contenedor al puerto 5433 del host
# (el 5432 de adentro no es accesible directo). En produccion (Railway) el
# puerto real lo da la plataforma, no este valor.
DB_PORT=5433
DB_USERNAME=espaciopublico
DB_PASSWORD=espaciopublico
DB_DATABASE=espaciopublico

# Almacenamiento de fotos y actas (opcional en local).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
